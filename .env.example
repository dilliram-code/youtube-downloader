# Vidora Environment Configuration
APP_NAME=Vidora
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
SECRET_KEY=change-this-in-production-to-a-secure-random-key-vidora-32b

# Database
DATABASE_URL=sqlite+aiosqlite:///./vidora.db

# Media Processing Engine & Paths
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe
DOWNLOADS_DIR=./storage/downloads
TEMP_DIR=./storage/temp

# Limits & Concurrency
MAX_DOWNLOAD_SIZE_MB=2048
MAX_CONCURRENT_JOBS=3
JOB_RETENTION_HOURS=6
JOB_TIMEOUT_SECONDS=600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Optional Search Provider Credentials (YouTube Data API v3, Vimeo, etc.)
# If empty, discovery falls back to compliant direct provider or shows setup guidance
YOUTUBE_API_KEY=
